# ==============================================================================
# FinSight AI — Environment Variables Configuration
# ==============================================================================
# In production on Vercel, set these in the Project Settings > Environment Variables.
# Copy this file to .env.local for local development.

# --- Application Mode ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_ENABLE_DEMO_DATA=true

# --- OpenAI Configuration (Server-Side Only) ---
# Used for Agentic LLM Orchestration and Multilingual Explanations
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Supabase Database & Auth (Optional for Demo Mode, Required for Production) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Market & Intelligence API Keys (Optional - Demo Fallback Built-in) ---
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
NEWS_API_KEY=
